DEBUG=False
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
USE_SQLITE=False

DB_NAME=aras_ai_data
DB_USER=aras_ai_data
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

DATA_HOST=127.0.0.1
DATA_PORT=8107

ROUTER_BASE_URL=http://127.0.0.1:8101
ROUTER_API_KEY=

CELERY_BROKER_URL=redis://127.0.0.1:6379/14
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/14
CELERY_TASK_DEFAULT_QUEUE=aras_ai_data

SQL_ROW_LIMIT=100
SQL_TIMEOUT_SECONDS=300
REQUEST_CONNECT_TIMEOUT=5
REQUEST_READ_TIMEOUT=120

MEDIA_ROOT=
DATABASE_UPLOAD_SEPARATE_SCHEMAS=1

# Linked DB passwords are stored in the service DB (server-side only).
# Never returned by API serializers; never put into LLM prompts.
# v1 has no application-level encryption (documented limitation).
CREDENTIAL_STORAGE=service_db_plaintext
